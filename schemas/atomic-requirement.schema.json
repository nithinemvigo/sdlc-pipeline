{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atomic Requirements",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "requirement_id": {
        "type": "string",
        "pattern": "^REQ-[0-9]{3,}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "requirement_id",
      "title",
      "description"
    ],
    "additionalProperties": false
  }
}
